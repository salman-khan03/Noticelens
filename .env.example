# Frontend server-side proxy destination (no public secrets).
API_URL=http://127.0.0.1:8000
# Backend CORS origins. No wildcard for a hosted deployment.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Default provider is local rules; no credentials needed or loaded.
# PostgreSQL migration is optional and is not enabled in the demo.
